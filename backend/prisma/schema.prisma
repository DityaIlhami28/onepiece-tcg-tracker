generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  setCode   String?
  imageUrl  String?
  rarity    String?
  cardType  String?
  prices    Price[]
  createdAt DateTime @default(now())
}

model Price {
  id        Int      @id @default(autoincrement())
  cardId    Int
  card      Card     @relation(fields: [cardId], references: [id])
  platform  String
  price     Int
  title     String
  url       String
  scrapedAt DateTime @default(now())
}